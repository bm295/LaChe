{
  "name": "la-cheminee-fnb",
  "version": "1.0.0",
  "private": true,
  "description": "La Cheminee restaurant management backend",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
